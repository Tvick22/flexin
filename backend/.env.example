# Copy to backend/.env and adjust. Read by app/config.py.

# development | production (production refuses the dev JWT_SECRET).
ENVIRONMENT=development

# Matches docker-compose.yml. Async driver for the app; Alembic uses the same URL.
DATABASE_URL=postgresql+asyncpg://flexin:flexin@localhost:5432/flexin

# Comma-separated origins allowed to call the API from a browser (Expo web dev server).
# Native apps don't send an Origin header, so they aren't affected by this.
CORS_ORIGINS=http://localhost:8081

# Signs access tokens. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
