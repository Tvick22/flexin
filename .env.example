# App environment. Copy to .env.local (gitignored) and adjust for your machine.
# EXPO_PUBLIC_ vars are bundled into the app, so never put secrets here.

# Where the Flexin' API runs (see backend/README.md for emulator/phone values).
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google sign-in (optional until you have them; the button only shows when set).
# From Google Cloud Console > APIs & Services > Credentials. The WEB client ID is
# the ID token's audience: add it to GOOGLE_CLIENT_IDS in backend/.env too.
# The iOS client ID also enables the native plugin via app.config.ts (needs a rebuild).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
